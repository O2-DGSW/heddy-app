# 원스토어에 올릴 릴리즈 빌드를 서명하는 데 쓰는 값이다.
# 이 파일을 keystore.properties 로 복사해 실제 값을 채운다 — keystore.properties 는 .gitignore 에 걸려 있다.
#
# 키스토어는 이렇게 만든다(비밀번호는 만드는 사람이 직접 입력):
#   keytool -genkey -v -keystore heddy-release.jks \
#     -alias heddy -keyalg RSA -keysize 2048 -validity 10000
#
# 원스토어는 구글플레이와 달리 서명 키를 대신 보관해 주지 않는다.
# 이 키를 잃어버리면 같은 앱으로는 영원히 업데이트할 수 없으니 팀 비밀번호 관리소에 반드시 백업할 것.

# android/ 기준 상대경로 또는 절대경로
storeFile=heddy-release.jks
storePassword=
keyAlias=heddy
keyPassword=
