{
  "name": "heddy-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ios": "npx cap add ios",
    "android": "npx cap add android",
    "dev": "vite",
    "dev:ios": "CAPACITOR_LIVE=true CAPACITOR_LIVE_HOST=localhost npx cap sync ios && npx cap open ios",
    "dev:android": "CAPACITOR_LIVE=true CAPACITOR_LIVE_HOST=10.0.2.2 npx cap sync android && npx cap open android",
    "build": "tsc -b && vite build",
    "build:ios": "pnpm build && npx cap sync ios && npx cap open ios",
    "build:android": "pnpm build && npx cap sync android && npx cap open android",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@heddy/design-tokens": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
